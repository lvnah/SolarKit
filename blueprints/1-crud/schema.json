{
  "app": {
    "name": "SolarKit · Base CRUD",
    "description": "Modèle de départ minimal : deux tables, tous les types de champs, CRUD complet."
  },
  "tables": {
    "notes": {
      "label": "Notes",
      "order": "id desc",
      "access": { "read": "public", "write": "user" },
      "fields": {
        "title":    { "type": "text",     "label": "Titre", "required": true },
        "content":  { "type": "textarea", "label": "Contenu" },
        "category": { "type": "select",   "label": "Catégorie", "options": ["Idée", "Tâche", "Rappel", "Archive"], "default": "Idée" },
        "priority": { "type": "int",      "label": "Priorité", "default": 2, "hint": "1 = haute, 3 = basse" },
        "due_date": { "type": "date",     "label": "Échéance" },
        "done":     { "type": "bool",     "label": "Terminé", "default": 0 }
      }
    },
    "contacts": {
      "label": "Contacts",
      "order": "name asc",
      "access": { "read": "public", "write": "user" },
      "fields": {
        "name":    { "type": "text",  "label": "Nom", "required": true },
        "email":   { "type": "email", "label": "E-mail" },
        "phone":   { "type": "text",  "label": "Téléphone" },
        "company": { "type": "text",  "label": "Société" },
        "website": { "type": "url",   "label": "Site web" },
        "notes":   { "type": "textarea", "label": "Remarques" }
      }
    }
  }
}
